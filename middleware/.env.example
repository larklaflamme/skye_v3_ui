# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES=24h

# Redis
REDIS_URL=redis://localhost:6379

# Skye Engine
SKYE_ENGINE_INBOX_KEY=skye:master:inbox
SKYE_ENGINE_OUTBOX_KEY=skye:channel:web:out
SKYE_ENGINE_STREAM_PREFIX=skye:stream:conv:web:

# EBv3
EBV3_URL=ws://localhost:8765

# Database
SQLITE_PATH=./data/skye_middleware.db

# Activation Codes
ACTIVATION_CODE_PREFIX=RN-SKYE-510510
ACTIVATION_CODE_EXPIRY_DAYS=30
